{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PSJLAP0168;Database=teste;Trusted_Connection=True;;TrustServerCertificate=True"
  },
  "Environment": "Development",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOptions": {
    "PolicyName": "AllowAll",
    "Origins": "*",
    "Methods": "*",
    "Headers": "*"
  },
  "CorsPolicies": {
    "Development": {
      "PolicyName": "AllowAllDevelopment",
      "Origins": [
        "http://localhost:3000",
        "http://localhost:5000"
      ],
      "Methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "Headers": [
        "*"
      ]
    },
    "Production": {
      "PolicyName": "DefaultRestricted",
      "Origins": [
        "https://your-production-domain.com"
      ],
      "Methods": [
        "GET",
        "POST"
      ],
      "Headers": [
        "Content-Type",
        "Authorization"
      ]
    }
  },
  "JwtOptions": {
    "Issuer": "YourAppIssuer",
    "Audience": "YourAppAudience",
    "Secret": "ReplaceThisDevelopmentSecretWithSecureValue",
    "ExpiryMinutes": 60
  },
  "Authentication": {
    "Cookie": {
      "Name": ".YourApp.Auth",
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Lax"
    },
    "Schemes": {
      "Jwt": "Bearer",
      "Cookie": "Cookies"
    }
  },
  "Authorization": {
    "Roles": {
      "Admin": "Admin",
      "User": "User"
    },
    "Policies": {
      "RequireAdministratorRole": "Admin",
      "RequireUserRole": "User"
    }
  }
}
