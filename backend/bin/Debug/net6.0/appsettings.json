{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PSJLAP0168;Database=teste;Trusted_Connection=True;;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "CorsOptions": {
    "PolicyName": "AllowAll",
    "Origins": "*",
    "Methods": "*",
    "Headers": "*"
  },

  "CorsOptionsByEnvironment": {
    "Development": {
      "PolicyName": "AllowAll",
      "Origins": ["*"],
      "Methods": ["*"],
      "Headers": ["*"]
    },
    "Production": {
      "PolicyName": "DefaultCorsPolicy",
      "Origins": [
        "https://example.com",
        "https://api.example.com"
      ],
      "Methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "Headers": [
        "Content-Type",
        "Authorization"
      ]
    }
  },

  "JwtSettings": {
    "Secret": "REPLACE_WITH_SECURE_KEY_OF_MIN_32_CHARS",
    "Issuer": "YourAppIssuer",
    "Audience": "YourAppAudience",
    "ExpiryMinutes": 60,
    "RequireHttpsMetadata": true,
    "ValidateIssuerSigningKey": true
  },

  "Authorization": {
    "Policies": {
      "RequireAdministratorRole": ["Administrator"],
      "RequireUserRole": ["User", "Administrator"]
    }
  }
}
