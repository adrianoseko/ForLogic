{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PSJLAP0168;Database=teste;Trusted_Connection=True;;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Development",
  "CorsOptions": {
    "PolicyName": "AllowAll",
    "Origins": "*",
    "Methods": "*",
    "Headers": "*"
  },
  "CorsOptions_ProductionTemplate": {
    "PolicyName": "DefaultRestricted",
    "Origins": [
      "https://your-production-domain.com"
    ],
    "Methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "Headers": [
      "Content-Type",
      "Authorization"
    ]
  },
  "Authentication": {
    "DefaultScheme": "JwtBearer",
    "Jwt": {
      "Key": "Dev_Temporary_Key_Replace_In_Production",
      "Issuer": "MyApp.Dev",
      "Audience": "MyApp.Dev",
      "ExpireMinutes": 60
    },
    "Cookie": {
      "Name": ".MyApp.Auth",
      "SameSite": "Lax",
      "SecurePolicy": "None"
    }
  },
  "Authorization": {
    "Policies": {
      "RequireAdministratorRole": {
        "RequiredRole": "Administrator"
      },
      "RequireUserRole": {
        "RequiredRole": "User"
      }
    },
    "Roles": [
      "Administrator",
      "User"
    ]
  }
}
