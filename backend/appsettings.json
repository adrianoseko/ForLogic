{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PSJLAP0168;Database=teste;Trusted_Connection=True;;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOptions": {
    "PolicyName": "AllowAll",
    "Origins": "*",
    "Methods": "*",
    "Headers": "*"
  },
  "CorsProfiles": {
    "Development": {
      "PolicyName": "AllowAll",
      "Origins": "*",
      "Methods": "*",
      "Headers": "*"
    },
    "Production": {
      "PolicyName": "Restricted",
      "Origins": [
        "https://example.com",
        "https://api.example.com"
      ],
      "Methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "Headers": [
        "Content-Type",
        "Authorization"
      ]
    }
  },
  "JwtSettings": {
    "Issuer": "MyAppIssuer",
    "Audience": "MyAppAudience",
    "Secret": "REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS",
    "TokenExpiryMinutes": 60
  },
  "CookieAuth": {
    "CookieName": ".MyApp.Auth",
    "CookieSecure": "Always",
    "CookieHttpOnly": true,
    "CookieSameSite": "Strict"
  },
  "Authorization": {
    "Policies": {
      "AdminOnly": [ "Administrator" ],
      "UserAccess": [ "User", "Administrator" ]
    }
  }
}
